# Copy to .env. Environment variables override this file. Never commit real secrets.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kitsuma
# Supabase: copy the session-pooler connection URI, replace its password, append ?sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
